# ==============================================================================
# Rice URL Shortener & QR Studio - .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Private Files, Environment Variables & Secrets
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
*.env
*.local
*.secret
*.private

# Service Accounts & Cloud Credentials
*serviceAccount*.json
*service-account*.json
service_account*.json
private_key.json
secrets.json

# Keystores, Certificates, and Private Keys
*.keystore
*.jks
*.p12
*.p8
*.pem
*.key
*.crt
*.cer
*.der
key.properties
local.properties

# ------------------------------------------------------------------------------
# 2. Node & Build Logs
# ------------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
ui-debug.log*
.runtimeconfig.json

# ------------------------------------------------------------------------------
# 3. Flutter, Dart & Build Artifacts
# ------------------------------------------------------------------------------
.dart_tool/
.dart-tool/
.config/
.agents/teamwork/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub/
.pub-cache/
/build/
/coverage/
*.lcov
**/doc/api/
**/ios/Flutter/.last_build_id

# Symbolication & Obfuscation
app.*.symbols
app.*.map.json

# Platform build targets
/android/app/debug
/android/app/profile
/android/app/release

# ------------------------------------------------------------------------------
# 4. IDEs, Editors & Workspaces
# ------------------------------------------------------------------------------
# IntelliJ / Android Studio
.idea/
*.iml
*.ipr
*.iws

# Visual Studio Code
.vscode/
!.vscode/settings.json.example
!.vscode/tasks.json.example

# General editors
*.swp
*.swo
*~
*.bak
.atom/
.history/
.sublime-*

# ------------------------------------------------------------------------------
# 5. Operating System & Miscellaneous
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*.class
*.pyc
.build/
.buildlog/
.svn/
.swiftpm/
migrate_working_dir/

# ------------------------------------------------------------------------------
# 6. Terraform State & Files
# ------------------------------------------------------------------------------
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
*.plan
crash.log
*.tfvars
*.tfvars.json
!terraform.tfvars.example
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc
terraform/*.zip

# ------------------------------------------------------------------------------
# 7. Serverpod Secrets, Local Configs & Native Binaries
# ------------------------------------------------------------------------------
config/passwords.yaml
server/config/passwords.yaml
**/config/passwords.yaml
!server/config/passwords.yaml.example
*.local.yaml
bin/server
server/bin/server

# ------------------------------------------------------------------------------
# 8. Database Migration Dumps
# ------------------------------------------------------------------------------
migrated_links*.sql
