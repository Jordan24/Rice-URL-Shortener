rules_version = "2";
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isRiceUser() {
      return isAuthenticated() &&
             request.auth.token.email.matches(".*@rice[.]edu$");
    }

    function isOwner(userId) {
      return isRiceUser() && request.auth.uid == userId;
    }

    // Links collection
    match /links/{linkId} {
      // Public single-document get allowed for URL redirection lookup
      allow get: if true;

      // Authenticated Rice users can list/query links in the dashboard
      allow list: if isRiceUser();

      // Rice users can create links owned by themselves
      allow create: if isRiceUser() &&
                      request.resource.data.userId == request.auth.uid &&
                      request.resource.data.userEmail == request.auth.token.email &&
                      request.resource.data.shortCode == linkId;

      // Link owners can update or delete their links
      allow update, delete: if isOwner(resource.data.userId);
    }
  }
}
